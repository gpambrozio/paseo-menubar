{
  "name": "paseo-menubar",
  "productName": "Paseo Icon",
  "version": "0.4.0",
  "description": "Menu-bar indicator for Paseo agents",
  "author": "Gustavo Ambrozio",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run && swift test --package-path PaseoIconPackage",
    "icons": "node scripts/make-icons.mjs",
    "fixtures:registry": "node scripts/make-registry-fixtures.mjs",
    "fixtures:e2ee": "node scripts/make-e2ee-fixtures.mjs PaseoIconPackage/Tests/PaseoIconCoreTests/Fixtures/e2ee-vectors.json",
    "test:swift": "swift test --package-path PaseoIconPackage",
    "dist": "npm run icons && node scripts/native-bundle.mjs"
  },
  "devDependencies": {
    "@getpaseo/server": "0.4.0",
    "@types/node": "^26.5.1",
    "classic-level": "^3.0.0",
    "lucide-static": "1.46.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "tweetnacl": "^1.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpambrozio/paseo-menubar.git"
  }
}
