{
  "name": "paseo-menubar",
  "productName": "Paseo Icon",
  "version": "0.2.0",
  "description": "Menu-bar indicator for Paseo agents",
  "author": "Gustavo Ambrozio",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "fixtures:registry": "node scripts/make-registry-fixtures.mjs",
    "start": "npm run build && npm run icons && electron .",
    "dist": "npm run build && npm run icons && electron-builder && npm run notarize:dmg",
    "notarize:dmg": "node scripts/notarize-dmg.mjs"
  },
  "dependencies": {
    "@getpaseo/client": "0.4.0",
    "@getpaseo/protocol": "0.4.0",
    "snappyjs": "^0.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@getpaseo/server": "0.4.0",
    "@types/node": "^24.6.0",
    "@types/snappyjs": "^0.7.1",
    "classic-level": "^2.0.0",
    "electron": "41.10.3",
    "electron-builder": "^26.8.1",
    "lucide-static": "1.31.0",
    "pino": "^9.5.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
