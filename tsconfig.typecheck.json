// The app is Swift. What is left to typecheck is the build tooling under
// scripts/, which is plain .mjs and never compiled into anything -- so this
// config stands alone rather than extending a build config, and emits nothing.
{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["scripts/**/*.mjs"],
  "exclude": []
}
